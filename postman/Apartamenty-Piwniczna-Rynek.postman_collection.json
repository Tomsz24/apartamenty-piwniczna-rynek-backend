          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/ttlock/locks", "description": "Skrypt ustawia pierwszy lockId tylko wtedy, gdy zmienna jest pusta. Przed testami zapisu wybierz właściwy zamek ręcznie." },
          "response": []
