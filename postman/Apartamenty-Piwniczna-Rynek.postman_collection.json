{
  "info": {
    "_postman_id": "1c5a6951-cc71-4f7e-9538-6dca0f90d42c",
    "name": "Apartamenty Piwniczna Rynek",
    "description": "Kompletna kolekcja lokalnego API NestJS. Najpierw uruchom request Auth / Pobierz token Supabase. Requesty oznaczone WRITE zmieniają dane. Operacje WRITE TTLock pozostają blokowane, dopóki TTLOCK_WRITES_ENABLED=false. Folder Hostex zawiera obecnie wyłącznie bezpieczne odczyty.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 Auth — Supabase",
      "description": "Logowanie użytkownika z emaila znajdującego się w ADMIN_EMAILS. Publishable key nie jest tokenem Bearer.",
      "item": [
        {
          "name": "Pobierz token Supabase",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logowanie zakończone powodzeniem', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.access_token) pm.environment.set('accessToken', body.access_token);",
                  "if (body.refresh_token) pm.environment.set('refreshToken', body.refresh_token);",
                  "if (body.expires_in) pm.environment.set('tokenExpiresIn', String(body.expires_in));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabasePublishableKey}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
            "description": "Wpisz adminEmail i adminPassword w środowisku. Po sukcesie skrypt zapisze accessToken i refreshToken."
          },
          "response": []
        },
        {
          "name": "Odśwież token Supabase",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token odświeżony', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.access_token) pm.environment.set('accessToken', body.access_token);",
                  "if (body.refresh_token) pm.environment.set('refreshToken', body.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabasePublishableKey}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{supabaseUrl}}/auth/v1/token?grant_type=refresh_token"
          },
          "response": []
        },
        {
          "name": "Sprawdź aktualnego użytkownika",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{supabasePublishableKey}}", "type": "text" }
            ],
            "url": "{{supabaseUrl}}/auth/v1/user"
          },
          "response": []
        }
      ]
    },
