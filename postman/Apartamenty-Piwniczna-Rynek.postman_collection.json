        {
          "name": "Szczegóły kodu",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "if (body.id) pm.environment.set('accessCodeId', body.id);",
              "if (body.version) pm.environment.set('accessCodeVersion', String(body.version));"
            ] }
          }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/access-codes/{{accessCodeId}}" },
          "response": []
        },
        {
          "name": "Użycia konkretnego kodu — bez zapisu lokalnego",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/access-codes/{{accessCodeId}}/usage" },
          "response": []
        },
        {
          "name": "WRITE DB — Odśwież i zapisz użycia kodu",
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/access-codes/{{accessCodeId}}/usage/refresh" },
          "response": []
        },
        {
          "name": "WRITE TTLOCK — Utwórz lub pobierz kod rezerwacji (automat)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "if (body.id) pm.environment.set('accessCodeId', body.id);",
              "if (body.version) pm.environment.set('accessCodeVersion', String(body.version));",
              "if (body.reservationId) pm.environment.set('reservationId', body.reservationId);",
              "if (body.validFrom) pm.environment.set('validFrom', body.validFrom);",
              "if (body.validUntil) pm.environment.set('validUntil', body.validUntil);"
            ] }
          }],
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/access-codes/by-reservation/{{reservationId}}",
            "description": "Główna ścieżka automatyczna. Wylicza godziny z polityki apartamentu, tworzy kod w TTLock i potwierdza go przez odczyt. Ponowienie zwraca ten sam aktywny kod. UWAGA: wymaga TTLOCK_WRITES_ENABLED=true, jeśli kod jeszcze nie istnieje."
          },
          "response": []
