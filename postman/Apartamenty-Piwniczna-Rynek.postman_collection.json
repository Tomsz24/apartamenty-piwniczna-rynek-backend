    {
      "name": "02 Reservations",
      "item": [
        {
          "name": "Lista rezerwacji",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const rows = pm.response.json();",
              "if (Array.isArray(rows) && rows[0]) {",
              "  pm.environment.set('reservationId', rows[0].id);",
              "  pm.environment.set('reservationVersion', String(rows[0].version));",
              "  if (rows[0].apartmentId) pm.environment.set('apartmentId', rows[0].apartmentId);",
              "}"
            ] }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations",
              "host": ["{{baseUrl}}"],
              "path": ["reservations"],
              "query": [
                { "key": "apartmentId", "value": "{{apartmentId}}", "disabled": true },
                { "key": "from", "value": "{{fromDate}}", "disabled": true },
                { "key": "to", "value": "{{toDate}}", "disabled": true },
                { "key": "status", "value": "{{reservationStatus}}", "disabled": true },
                { "key": "includeCancelled", "value": "false", "disabled": true }
