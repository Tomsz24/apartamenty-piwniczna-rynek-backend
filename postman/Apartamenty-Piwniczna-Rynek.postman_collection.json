              "query": [
                { "key": "apartmentId", "value": "{{apartmentId}}", "disabled": true },
                { "key": "reservationId", "value": "{{reservationId}}", "disabled": true },
                { "key": "status", "value": "{{accessCodeStatus}}", "disabled": true },
                { "key": "from", "value": "{{validFrom}}", "disabled": true },
                { "key": "to", "value": "{{validUntil}}", "disabled": true },
                { "key": "cursor", "value": "{{accessCodeCursor}}", "disabled": true },
                { "key": "limit", "value": "50", "disabled": true }
              ]
            }
          },
          "response": []
