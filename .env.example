# Backend
PORT=3000

# PostgreSQL / Supabase
DATABASE_URL=
DATABASE_SSL=true
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ADMIN_EMAILS=

# Booking iCal. Synchronizacja pozostaje wyłączona podczas przebudowy systemu.
ICAL_SYNC_ENABLED=false
ICAL_GORY_TOKEN=
ICAL_RYNEK_TOKEN=

# Hostex OpenAPI V3. Na pierwszym etapie używaj tokenu o zakresie read-only.
HOSTEX_ENABLED=false
# Flaga jest zarezerwowana na późniejszy etap. Obecny moduł nie udostępnia
# żadnych operacji zapisujących nawet po przypadkowym ustawieniu true.
HOSTEX_WRITES_ENABLED=false
HOSTEX_API_BASE_URL=https://api.hostex.io/v3
HOSTEX_REQUEST_TIMEOUT_MS=10000
HOSTEX_READ_RETRY_COUNT=1
HOSTEX_RETRY_BASE_DELAY_MS=250
HOSTEX_USER_AGENT=ApartamentyPiwnicznaBackend/1.0
HOSTEX_ACCESS_TOKEN=

# TTLock Cloud API V3
TTLOCK_ENABLED=false
# Pozostaw false do czasu osobno zatwierdzonego testu na jednym zamku.
TTLOCK_WRITES_ENABLED=false
TTLOCK_API_BASE_URL=https://api.sciener.com
TTLOCK_REQUEST_TIMEOUT_MS=10000
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=

# Konto ze zwykłej aplikacji TTLock, które jest właścicielem zamków.
# Hash MD5 jest odpowiednikiem sekretu i również nie może trafić do repozytorium.
TTLOCK_ACCOUNT_USERNAME=
TTLOCK_ACCOUNT_PASSWORD_MD5=

# Alternatywnie można rozpocząć od istniejących tokenów. Nie są wymagane,
# jeśli ustawiono TTLOCK_ACCOUNT_USERNAME i TTLOCK_ACCOUNT_PASSWORD_MD5.
TTLOCK_ACCESS_TOKEN=
TTLOCK_REFRESH_TOKEN=

# 32 losowe bajty zakodowane base64. Służą wyłącznie do szyfrowania kodów
# dostępu zapisanych w bazie. Wygeneruj lokalnie: openssl rand -base64 32
ACCESS_CODE_ENCRYPTION_KEY=
# Awaryjny szkic ręcznej wymiany cyfr kodu. Główna ścieżka automatyczna nie
# korzysta ze szkiców ani z tego limitu.
ACCESS_CODE_DRAFT_TTL_MINUTES=30
