# PRZYKŁAD — skopiuj do .env lub ustaw zmienne w panelu hostingu.
# Uruchomienie: npm start albo npm run build && npm run start:prod.
# Przykład nie zawiera sekretów; integracje domyślnie wyłączone.
# Opis konfiguracji i wymaganych pól: docs/environment.md

# --- Aplikacja ---
PORT=3000

# --- Baza danych i logowanie administratora ---
# Wymagane: connection string PostgreSQL; hasło jest sekretem.
DATABASE_URL=
DATABASE_SSL=true
# URL projektu obsługującego logowanie administratora.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Dozwolone adresy administratorów, rozdzielone przecinkami.
ADMIN_EMAILS=

# --- Hostex — rezerwacje i wiadomości ---
# Dostęp do API Hostex. Wymaga HOSTEX_ACCESS_TOKEN.
HOSTEX_ENABLED=false
# Automatyczny import przy starcie i co 5 minut; wymaga HOSTEX_ENABLED=true.
HOSTEX_SYNC_ENABLED=false
# Zapisy do Hostex: wiadomości oraz tworzenie, edycja i anulowanie rezerwacji.
HOSTEX_WRITES_ENABLED=false
# Sekret; zapisy wymagają uprawnień writable.
HOSTEX_ACCESS_TOKEN=
HOSTEX_API_BASE_URL=https://api.hostex.io/v3
HOSTEX_REQUEST_TIMEOUT_MS=10000
HOSTEX_READ_RETRY_COUNT=1
HOSTEX_RETRY_BASE_DELAY_MS=250
HOSTEX_USER_AGENT=ApartamentyPiwnicznaBackend/1.0
# Sekret webhooka Hostex (secret_token z panelu/POST /webhooks). Puste = endpoint
# POST /api/hostex/webhook wyłączony. Przetwarzanie wymaga HOSTEX_ENABLED=true.
HOSTEX_WEBHOOK_SECRET=

# --- E-maile dla obsługi — Resend ---
# Włącz po migracji kolejki, weryfikacji domeny i ustawieniu START_AT.
RESERVATION_EMAIL_ENABLED=false
# Sekret z Resend, z uprawnieniem wysyłania dla domeny.
RESEND_API_KEY=
RESERVATION_EMAIL_FROM=rezerwacje@apartamenty-piwniczna-rynek.pl
# Jeden odbiorca; na czas testów tylko właściciel. Nie jest to adres gościa.
RESERVATION_EMAIL_TO=tomaszwojciechowski244@gmail.com
# Wymagane po włączeniu: ISO 8601 z offsetem, np. 2026-10-21T19:00:00+02:00.
# Stały początek wysyłki; nie zmieniaj przy restartach. Starsze zdarzenia są pomijane.
RESERVATION_EMAIL_START_AT=

# --- Wiadomość przyjazdowa ---
# Automatyczna wysyłka przez czat Hostex (Booking.com i inne kanały) o 10:00
# w dniu przyjazdu. Wymaga HOSTEX_WRITES_ENABLED=true i aktywnego kodu TTLock.
ARRIVAL_MESSAGE_AUTO_SEND_ENABLED=false

# --- Powiadomienia push (APNs) ---
# Przypomnienia, kontrola brakujących kodów i wysyłka push. Zdarzenia rezerwacji
# i błędów kodów trafiają do skrzynki w aplikacji niezależnie od tej flagi.
NOTIFICATIONS_ENABLED=false
# Klucz .p8 z Apple Developer (Keys → Apple Push Notifications service).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=Tomsz24.apartamenty-piwniczna-rynek
# Ścieżka do pliku .p8 poza repozytorium (np. /home/deploy/secrets/apns.p8, chmod 600)
# albo treść klucza w APNS_PRIVATE_KEY z \n zamiast nowych linii.
APNS_PRIVATE_KEY_PATH=
APNS_PRIVATE_KEY=
# Godzina (Europe/Warsaw) przypomnienia o niewysłanej wiadomości przyjazdowej.
NOTIFICATION_ARRIVAL_REMINDER_TIME=10:00
# Ile minut przed godziną zameldowania alarmować o braku kodu do drzwi.
NOTIFICATION_MISSING_CODE_LEAD_MINUTES=120

# --- TTLock — połączenie z zamkami ---
TTLOCK_ENABLED=false
# Pozwala wykonywać operacje na prawdziwych zamkach.
TTLOCK_WRITES_ENABLED=false
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
# Konto właściciela zamków w TTLock.
TTLOCK_ACCOUNT_USERNAME=
# Hash MD5 hasła jest sekretem, tak samo jak hasło.
TTLOCK_ACCOUNT_PASSWORD_MD5=
# Opcjonalne istniejące tokeny zamiast logowania kontem.
TTLOCK_ACCESS_TOKEN=
TTLOCK_REFRESH_TOKEN=
TTLOCK_API_BASE_URL=https://api.sciener.com
TTLOCK_REQUEST_TIMEOUT_MS=10000

# --- Kody dostępu — automatyzacja i szyfrowanie ---
# Włącza cykl kodów dostępu. Wymaga skonfigurowanego TTLock i uprawnień zapisu.
ACCESS_CODE_AUTOMATION_ENABLED=false
# 32 losowe bajty base64: openssl rand -base64 32
# Zachowaj istniejący klucz: jego zmiana uniemożliwi odszyfrowanie zapisanych kodów.
ACCESS_CODE_ENCRYPTION_KEY=
ACCESS_CODE_DRAFT_TTL_MINUTES=30
