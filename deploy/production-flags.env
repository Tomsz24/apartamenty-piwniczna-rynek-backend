# Jawne (niesekretne) ustawienia produkcji. scripts/sync-env-to-server.sh
# nadpisuje nimi .env na serwerze. Sekrety nigdy nie trafiają do tego pliku.
#
# Kolejność włączania: najpierw import i webhook Hostex, potem zapisy Hostex,
# TTLock i kody dostępu, na końcu e-maile. Zmień flagę, uruchom skrypt i wdróż.

NODE_ENV=production
PORT=3000

# Hostex: import co 5 minut, webhook oraz zapisy (wiadomości, rezerwacje z aplikacji).
HOSTEX_ENABLED=true
HOSTEX_SYNC_ENABLED=true
HOSTEX_WRITES_ENABLED=true

# TTLock i kody: zamki apartamentów przypisane (migracja 20261021190000); kody
# powstają automatycznie w dniu przyjazdu i znikają po anulowaniu.
TTLOCK_ENABLED=true
TTLOCK_WRITES_ENABLED=true
ACCESS_CODE_AUTOMATION_ENABLED=true

# E-maile o rezerwacjach: tylko zmiany od momentu uruchomienia (stała data, nie zmieniać).
RESERVATION_EMAIL_ENABLED=true
RESERVATION_EMAIL_START_AT=2026-10-21T21:40:00+02:00

# Powiadomienia push.
NOTIFICATIONS_ENABLED=true
APNS_KEY_ID=942RV3H224
APNS_TEAM_ID=46Y8GFJG3U
APNS_BUNDLE_ID=Tomsz24.apartamenty-piwniczna-rynek
APNS_PRIVATE_KEY_PATH=/home/deploy/secrets/apns.p8
