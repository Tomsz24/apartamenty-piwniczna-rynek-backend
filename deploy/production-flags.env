# Jawne (niesekretne) ustawienia produkcji. scripts/sync-env-to-server.sh
# nadpisuje nimi .env na serwerze. Sekrety nigdy nie trafiają do tego pliku.
#
# Kolejność włączania: najpierw import i webhook Hostex, potem zapisy Hostex,
# TTLock i kody dostępu, na końcu e-maile. Zmień flagę, uruchom skrypt i wdróż.

NODE_ENV=production
PORT=3000

# Hostex: import co 5 minut i webhook; zapisy (wiadomości, rezerwacje) później.
HOSTEX_ENABLED=true
HOSTEX_SYNC_ENABLED=true
HOSTEX_WRITES_ENABLED=false

# TTLock i kody: odczyt tak, operacje na zamkach dopiero po przypisaniu zamków.
TTLOCK_ENABLED=true
TTLOCK_WRITES_ENABLED=false
ACCESS_CODE_AUTOMATION_ENABLED=false

# E-maile o rezerwacjach: wyłączone do czasu ustawienia RESERVATION_EMAIL_START_AT.
RESERVATION_EMAIL_ENABLED=false

# Powiadomienia push.
NOTIFICATIONS_ENABLED=true
APNS_KEY_ID=942RV3H224
APNS_TEAM_ID=46Y8GFJG3U
APNS_BUNDLE_ID=Tomsz24.apartamenty-piwniczna-rynek
APNS_PRIVATE_KEY_PATH=/home/deploy/secrets/apns.p8
